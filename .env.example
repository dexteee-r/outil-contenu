# Copier ce fichier en `.env` et remplir. `.env` n'est jamais versionné.

# --- Dossiers -------------------------------------------------------------
# Racine des données : raw/, processing/, ready/ et la base SQLite vivent dedans.
# Sur Windows, un chemin absolu, par exemple D:\contenu
DATA_ROOT=./data

# Dossier des configs de comptes (défaut : ./accounts à la racine du repo)
# ACCOUNTS_DIR=./accounts

# Chemin de la base SQLite (défaut : <DATA_ROOT>/outil.sqlite)
# DB_PATH=

# --- Clés API -------------------------------------------------------------
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# kie.ai : passerelle payante vers GPT Image 2, Nano Banana, Seedream, Ideogram (https://kie.ai/api-key)
KIE_API_KEY=
# Fournisseur des miniatures : gemini (clé Google, facturation requise) | kie
IMAGE_PROVIDER=gemini

# --- Modèles ----------------------------------------------------------------
# Les IDs vivent ici pour basculer gratuit/payant ou changer de version sans toucher au code.
# IDs Gemini exacts à vérifier sur https://ai.google.dev/gemini-api/docs/models
MODEL_TAGGING=gemini-3.7-flash
# Avec IMAGE_PROVIDER=kie : alias kie.ai (gpt-image-2 | nano-banana-pro | seedream-4.5) ; avec gemini : ID Google
MODEL_IMAGE=gpt-image-2
MODEL_EDL=claude-sonnet-5
MODEL_CAPTIONS=claude-sonnet-5
MODEL_JUDGE=claude-sonnet-5

# --- Notifications (étape 6) ------------------------------------------------
# Discord : Paramètres du salon → Intégrations → Webhooks → Copier l'URL (secret : ne pas partager)
DISCORD_WEBHOOK_URL=
# Alternative : webhooks n8n qui reçoivent le JSON brut
N8N_WEBHOOK_READY_URL=
N8N_WEBHOOK_FAILED_URL=

# --- Surveillance de /raw (pnpm content watch) ---------------------------------
# Minutes sans changement dans un dossier de rushs avant de le traiter (transfert terminé)
WATCH_QUIET_MINUTES=2
# Alerte quand l'espace libre du disque des données passe sous ce seuil (Go)
DISK_ALERT_FREE_GB=50

# --- Coûts --------------------------------------------------------------------
# Les API facturent en USD ; le budget du cahier est en EUR.
USD_EUR_RATE=0.92
