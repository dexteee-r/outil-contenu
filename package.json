{
  "name": "outil-contenu",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "cli": "tsx apps/worker/src/cli.ts",
    "check": "pnpm cli doctor",
    "db:migrate": "pnpm cli db:migrate",
    "db:generate": "pnpm -C packages/core exec drizzle-kit generate",
    "config:check": "pnpm cli config:check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content": "pnpm cli pipeline",
    "inspiration": "pnpm cli inspiration",
    "miniatures": "pnpm cli inspiration:web"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
